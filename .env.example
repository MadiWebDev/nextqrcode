# ── NextQRCode environment ──────────────────────────────────────────────
# Copy to .env.local and fill in. The app builds and runs with NONE of these
# set; each missing credential degrades to a documented local behavior.

# Canonical public URL of the site (used for SEO, short links, OG images)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (MongoDB Atlas) — saved QR codes, users, analytics ────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>/<db>?retryWrites=true&w=majority

# ── Auth (Auth.js v5) ──────────────────────────────────────────────────────
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Email magic link (SMTP), e.g. smtp://user:pass@smtp.example.com:587
EMAIL_SERVER=
EMAIL_FROM=noreply@example.com

# ── Cloudinary (signed uploads) ────────────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Rate limiting (Upstash Redis; in-memory fallback in dev) ───────────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Abuse prevention ───────────────────────────────────────────────────────
GOOGLE_SAFE_BROWSING_API_KEY=
# Salt for privacy-safe IP hashing in scan analytics (rotate to invalidate)
IP_HASH_SALT=

# ── Ads (consent-gated; empty = no ads rendered) ───────────────────────────
NEXT_PUBLIC_ADSENSE_CLIENT=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=

# ── Analytics (loaded only after consent) ──────────────────────────────────
NEXT_PUBLIC_ANALYTICS_ID=

# ── Misc ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
CONTACT_EMAIL=hello@example.com

# ---- Phase 3: accounts, database, uploads ----
# MongoDB Atlas (required for accounts, dynamic QR, analytics)
MONGODB_URI="mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nextqrcode?retryWrites=true&w=majority"

# Auth.js v5 — generate with: openssl rand -base64 32
AUTH_SECRET=""
# Google OAuth (optional — enables "Continue with Google")
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Email magic link (optional — enables passwordless email sign-in)
EMAIL_SERVER="smtp://<user>:<password>@<host>:587"
EMAIL_FROM="noreply@example.com"

# Cloudinary (required for logo uploads)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google Safe Browsing (optional — dynamic-link destination checks)
GOOGLE_SAFE_BROWSING_API_KEY=""

# Upstash Redis (optional — distributed rate limiting; falls back to in-memory)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Salt for daily-rotating IP hashes in scan analytics
IP_HASH_SALT=""
