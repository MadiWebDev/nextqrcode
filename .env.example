# ── NextQRCode environment ──────────────────────────────────────────────
# Copy to .env.local and fill in. The app builds and runs with NONE of these
# set; each missing credential degrades to a documented local behavior.
# All variables below are referenced via process.env in src/ (audited
# 2026-10-19). NEXT_PUBLIC_* values are inlined at build time — redeploy
# after changing them.

# Canonical public URL of the site (SEO, short links, OG images, sitemap).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Database (MongoDB Atlas) ──────────────────────────────────────────────
# Saved QR codes, users, templates, scan analytics. Required for accounts,
# dynamic QR, and analytics. Must point at a replica set (Atlas default).
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/nextqrcode?retryWrites=true&w=majority

# ── Auth (Auth.js v5) ──────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32. Required for any auth flow.
AUTH_SECRET=
# Canonical origin Auth.js v5 derives callback URLs from (no trailing slash).
AUTH_URL=http://localhost:3000
# Google OAuth (optional — enables "Continue with Google").
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Email magic link (optional — enables passwordless sign-in).
# SMTP URL, e.g. smtp://user:pass@smtp.example.com:587
EMAIL_SERVER=
EMAIL_FROM=noreply@example.com

# ── Cloudinary (signed logo uploads) ───────────────────────────────────────
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Alternative single-string config (cloudinary://<key>:<secret>@<cloud>);
# accepted by src/lib/cloudinary.ts. Leave empty to use the three vars above.
CLOUDINARY_URL=

# ── Rate limiting (Upstash Redis; in-memory fallback per instance) ─────────
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Abuse prevention ───────────────────────────────────────────────────────
# Google Safe Browsing (optional — dynamic-link destination checks).
GOOGLE_SAFE_BROWSING_API_KEY=
# Salt for privacy-safe IP hashing in scan analytics (rotate to invalidate).
IP_HASH_SALT=
# Secret for password-reset/unlock token signing. Falls back to IP_HASH_SALT
# when empty (src/lib/security/abuse.ts); set explicitly in production.
PASSWORD_TOKEN_SECRET=

# ── Ads (consent-gated; empty = no ads rendered) ───────────────────────────
# AdSense publisher client ID shown in ad slots.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Alias for NEXT_PUBLIC_ADSENSE_CLIENT (also accepted).
NEXT_PUBLIC_ADSENSE_CLIENT_ID=
NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT=
NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR=
# Server-only publisher ID (digits only) served by the /ads.txt route.
ADSENSE_PUBLISHER_ID=

# ── Analytics (loaded only after consent) ──────────────────────────────────
NEXT_PUBLIC_ANALYTICS_ID=
# Google Analytics 4 measurement ID used by src/lib/gtag.ts (G-XXXXXXXXXX).
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ── Error tracking (optional — unset = console logging only) ───────────────
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# ── Misc ───────────────────────────────────────────────────────────────────
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
CONTACT_EMAIL=hello@example.com
