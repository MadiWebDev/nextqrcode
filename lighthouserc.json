{
  "//": "Lighthouse CI config for Phase 9. Run via `npm run lhci` (script to be added to package.json by the coordinator — this file must NOT edit package.json). Expected script: \"lhci\": \"lhci autorun\". CI starts the production server itself (startServerCommand); locally, run `npm run build && npm run start` first or point --collect.url at a running instance.",
  "ci": {
    "assert": {
      "assertMatrix": [
        {
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.98 }]
          },
          "matchingUrlPattern": "http://localhost:3000/$"
        },
        {
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.98 }]
          },
          "matchingUrlPattern": "http://localhost:3000/wifi-qr-code-generator$"
        },
        {
          "assertions": {
            "categories:accessibility": ["error", { "minScore": 0.95 }],
            "categories:best-practices": ["error", { "minScore": 0.95 }],
            "categories:performance": ["error", { "minScore": 0.9 }],
            "categories:seo": ["error", { "minScore": 0.98 }]
          },
          "matchingUrlPattern": "http://localhost:3000/industries/restaurant-digital-menu$"
        }
      ]
    },
    "collect": {
      "numberOfRuns": 3,
      "settings": {
        "onlyCategories": ["performance", "accessibility", "best-practices", "seo"],
        "preset": "desktop"
      },
      "startServerCommand": "npm run start -- --port 3000",
      "url": [
        "http://localhost:3000/",
        "http://localhost:3000/wifi-qr-code-generator",
        "http://localhost:3000/industries/restaurant-digital-menu"
      ]
    },
    "upload": { "target": "temporary-public-storage" }
  }
}
