{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nextqrcode",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-11-23",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public", "no_handle_cross_request_promise_resolution"],
  "upload_source_maps": true,

  // Raise CPU ceiling (Workers Paid only — ignored on Free, which is hard-capped at 10 ms)
  "limits": { "cpu_ms": 30000 },

  // Run the Worker close to your MongoDB origin to cut connection latency/drops
  "placement": { "mode": "smart" },

  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },

  "services": [
    { "binding": "WORKER_SELF_REFERENCE", "service": "nextqrcode" }
  ],

  "workers_dev": true,

  "routes": [
    { "pattern": "freeqrcode.tools", "custom_domain": true },
    { "pattern": "imageresizer.freeqrcode.tools", "custom_domain": true },
    { "pattern": "invoicegenerator.freeqrcode.tools", "custom_domain": true },
    { "pattern": "socialcalendar.freeqrcode.tools", "custom_domain": true },
    { "pattern": "resumebuilder.freeqrcode.tools", "custom_domain": true }
  ],

  // Declare secrets so deploys fail loudly if one is missing
  "secrets": {
    "required": [
      "AUTH_SECRET",
      "MONGODB_URI",
      "CLOUDINARY_API_SECRET",
      "NEXT_PUBLIC_ADSENSE_CLIENT",
      "NEXT_PUBLIC_ADSENSE_CLIENT_ID",
      "NEXT_PUBLIC_ADSENSE_SLOT_IN_CONTENT",
      "NEXT_PUBLIC_ADSENSE_SLOT_SIDEBAR",
      "NEXT_PUBLIC_GA_MEASUREMENT_ID",
      "NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION"
    ]
  },

  "vars": {
    "NEXT_PUBLIC_SITE_URL": "https://freeqrcode.tools",
    "AUTH_URL": "https://freeqrcode.tools",
    "AUTH_TRUST_HOST": "true",

    "EMAIL_FROM": "noreply@freeqrcode.tools",
    "CONTACT_EMAIL": "contact@freeqrcode.tools",

    "CLOUDINARY_CLOUD_NAME": "dpho9mktd",
    "CLOUDINARY_API_KEY": "583151786612987",

    "ADSENSE_PUBLISHER_ID": "pub-4860681021797211"
  },

  "observability": { "enabled": true }
}
