{
  "buildCommand": "npm run content:audit && npm run build",
  "headers": [
    {
      "source": "/_next/static/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/sitemap(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }]
    },
    {
      "source": "/(.*).xml",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, s-maxage=3600" }]
    }
  ]
}
